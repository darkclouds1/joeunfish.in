[ln1009]code=000[ln1025]sql=SELECT DISTINCT major_code AS code, major_nm AS code_nm 
                FROM tcodebook
                WHERE code IN ('000', '001')  -- 000=명절, 001=행사기획
                ORDER BY major_code
