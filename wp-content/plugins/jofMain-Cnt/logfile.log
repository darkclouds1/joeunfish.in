        SELECT 
            YEARWEEK(STR_TO_DATE(ord.supply_dt, '%Y%m%d'),1) AS year_week,
            MIN(STR_TO_DATE(ord.supply_dt, '%Y%m%d')) AS week_start,
            MAX(STR_TO_DATE(ord.supply_dt, '%Y%m%d')) AS week_end,
