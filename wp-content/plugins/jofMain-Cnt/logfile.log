            AND ord.supply_dt BETWEEN '20250607' AND '20250907'
        GROUP BY 
            YEARWEEK(STR_TO_DATE(ord.supply_dt, '%Y%m%d'), 1)
        ORDER BY 
            year_week DESC
        LIMIT 13
    
