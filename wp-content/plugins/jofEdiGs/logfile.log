sql=
        SELECT 
            COM.store_code AS product_code,
            COM.code_exp AS product_name,
            COALESCE(SUM(PRD.quantity), 0) AS '총수량',
            COALESCE(SUM(CASE WHEN ORD.dest_code = 'V7R48' THEN PRD.quantity ELSE 0 END), 0) AS `GS25평내본점`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'V7Y75' THEN PRD.quantity ELSE 0 END), 0) AS `GS25만수센터점`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'V8R74' THEN PRD.quantity ELSE 0 END), 0) AS `GS25남동히트점`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VDE55' THEN PRD.quantity ELSE 0 END), 0) AS `GS25성북꿈의숲점`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VEJ23' THEN PRD.quantity ELSE 0 END), 0) AS `GS25논현이편한점`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV03' THEN PRD.quantity ELSE 0 END), 0) AS `(주)지에스리테일(아신A)`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV04' THEN PRD.quantity ELSE 0 END), 0) AS `(주)지에스리테일공주일배`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV16' THEN PRD.quantity ELSE 0 END), 0) AS `(주)지에스리테일원주일배`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV17' THEN PRD.quantity ELSE 0 END), 0) AS `(주)지에스리테일발안일배`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV20' THEN PRD.quantity ELSE 0 END), 0) AS `(주)지에스리테일(해인CVS)`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV25' THEN PRD.quantity ELSE 0 END), 0) AS `(주)지에스리테일진주일배`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV34' THEN PRD.quantity ELSE 0 END), 0) AS `(주)지에스리테일청주일배`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV53' THEN PRD.quantity ELSE 0 END), 0) AS `(주)지에스리테일송파일배`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV55' THEN PRD.quantity ELSE 0 END), 0) AS `(주)지에스리테일송파2일배`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV57' THEN PRD.quantity ELSE 0 END), 0) AS `(주)지에스리테일김해일배`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV58' THEN PRD.quantity ELSE 0 END), 0) AS `(주)지에스리테일김해2일배`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV62' THEN PRD.quantity ELSE 0 END), 0) AS `(주)지에스리테일김포2일배`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV63' THEN PRD.quantity ELSE 0 END), 0) AS `㈜지에스리테일고양일배센터`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV64' THEN PRD.quantity ELSE 0 END), 0) AS `㈜지에스리테일고양일배2`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV65' THEN PRD.quantity ELSE 0 END), 0) AS `㈜지에스리테일익산일배`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV66' THEN PRD.quantity ELSE 0 END), 0) AS `지에스리테일인천도화일배`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV67' THEN PRD.quantity ELSE 0 END), 0) AS `지에스리테일인천도화2일배`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV69' THEN PRD.quantity ELSE 0 END), 0) AS `㈜지에스리테일강릉일배센터`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV70' THEN PRD.quantity ELSE 0 END), 0) AS `㈜지에스리테일김포3일배`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV71' THEN PRD.quantity ELSE 0 END), 0) AS `(주)지에스리테일발안2일배`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV75' THEN PRD.quantity ELSE 0 END), 0) AS `(주)지에스리테일공주2일배`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV81' THEN PRD.quantity ELSE 0 END), 0) AS `(주)지에스리테일고양저온3`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV83' THEN PRD.quantity ELSE 0 END), 0) AS `지에스리테일경산저온`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV84' THEN PRD.quantity ELSE 0 END), 0) AS `㈜지에스리테일경산2저온`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV85' THEN PRD.quantity ELSE 0 END), 0) AS `지에스리테일신오산1저온`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV86' THEN PRD.quantity ELSE 0 END), 0) AS `지에스리테일신오산2저온`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV87' THEN PRD.quantity ELSE 0 END), 0) AS `지에스리테일신오산3저온`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV90' THEN PRD.quantity ELSE 0 END), 0) AS `(주)지에스리테일포천저온`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV91' THEN PRD.quantity ELSE 0 END), 0) AS `(주)지에스리테일포천2저온`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV92' THEN PRD.quantity ELSE 0 END), 0) AS `(주)지에스리테일신제주저온`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV93' THEN PRD.quantity ELSE 0 END), 0) AS `(주)지에스리테일곤지암센터`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV94' THEN PRD.quantity ELSE 0 END), 0) AS `(주)지에스리테일곤지암2센`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV95' THEN PRD.quantity ELSE 0 END), 0) AS `(주)지에스리테일신광주저온`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV96' THEN PRD.quantity ELSE 0 END), 0) AS `(주)지에스리테일신광주2저`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV97' THEN PRD.quantity ELSE 0 END), 0) AS `(주)지에스리테일경산3저온`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV98' THEN PRD.quantity ELSE 0 END), 0) AS `(주)지에스리테일고촌저온`,COALESCE(SUM(CASE WHEN ORD.dest_code = 'VV99' THEN PRD.quantity ELSE 0 END), 0) AS `(주)지에스리테일고촌2저온`
        FROM 
            tcomcodegs COM
        LEFT JOIN torderproducts PRD ON COM.store_code = PRD.product_code
        LEFT JOIN torders ORD ON ORD.doc_no = PRD.doc_no 
        WHERE COM.grp_code = 2
          AND COM.use_yn = 'y'
          AND ORD.msgfrom = 'GSCT04:DC'
          AND ORD.supply_dt = '20250716' 
        GROUP BY 
            COM.code_exp, COM.store_code
        ORDER BY 
            COM.order_num
    